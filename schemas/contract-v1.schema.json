{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://probante.local/schemas/contract-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "description", "scope", "preconditions", "timeout_ms", "cases"],
  "properties": {
    "schema_version": {"const": "1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "scope": {"type": "string", "minLength": 1},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "timeout_ms": {"const": 2000},
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "description", "arguments", "expected"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "arguments": {"type": "array", "items": {"type": "string"}},
          "expected": {
            "type": "object", "additionalProperties": false,
            "required": ["exit_code", "stdout", "stderr"],
            "properties": {
              "exit_code": {"type": "integer"},
              "stdout": {"type": "string"},
              "stderr": {"type": "string"}
            }
          }
        }
      }
    }
  }
}

